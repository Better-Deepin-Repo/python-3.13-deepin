+                    return onerror(func, path, exc_info)
+        elif not _onexc_kwargs:
+            # Only the internal caller in tempfile asks for the extra arguments.
+            _onexc = onexc
+            def onexc(func, path, err, **kwargs):
+                return _onexc(func, path, err)
+
