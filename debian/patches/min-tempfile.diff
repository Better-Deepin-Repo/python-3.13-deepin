+        _sys.audit("shutil.rmtree", path, dir_fd)
+        if ignore_errors:
+            def onexc(*args, **kwargs):
+                pass
+        elif onerror is None and onexc is None:
+            def onexc(*args, **kwargs):
+                raise
+        elif onexc is None:
+            if onerror is None:
+                def onexc(*args, **kwargs):
+                    raise
+            else:
+                # delegate to onerror
+                def onexc(*args, **kwargs):
+                    func, path, exc = args
+                    if exc is None:
+                        exc_info = None, None, None
+                    else:
